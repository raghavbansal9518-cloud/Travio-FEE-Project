# ===================================================================
# TRAVIO TRAVEL APP - LOCAL ENVIRONMENT TEMPLATE (.env.example)
# ===================================================================
# INSTRUCTIONS FOR TEAMMATES:
# 1. Duplicate this file and rename it to `.env` (or `.env.local`).
# 2. Add your personal Google Gemini and Google Places API keys below.
# 3. Do NOT commit your `.env` file to Git (it is blocked in .gitignore).
# 4. Run `npm run dev` to start Travio with the local secure API proxy.
# ===================================================================

# 1. Google Gemini API Key (Secret - Kept Server-Side by Local Proxy)
# Obtain free from Google AI Studio: https://aistudio.google.com/app/apikey
# Powers AI destination insights, travel summaries, and dynamic flight/train schedules.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Places API (New) Key (Secret - Kept Server-Side by Local Proxy)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure "Places API (New)" is enabled.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
